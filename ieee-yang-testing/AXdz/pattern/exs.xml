    </mask>
  </example-collection>
  <example-collection>
    <name>Ranges and individual numbers: 0-10, 21-31, 55</name>
    <mask>
      <lower-range>0</lower-range>
      <upper-range>10</upper-range>
    </mask>
    <mask>
      <lower-range>21</lower-range>
      <upper-range>31</upper-range>
    </mask>
    <mask>
      <lower-range>55</lower-range>
      <upper-range>55</upper-range>
    </mask>
